#
# Rust 1.99 reports E0365: __export re-exports a private extern crate.
# Make its existing proc_macro import public, as the compiler recommends.
# This is a host-side PIO macro dependency; no firmware runtime code changes.
# All other files are copied unmodified from the published crate.
# Zero-context patch: apply with git apply --unidiff-zero.

--- a/src/lib.rs
+++ b/src/lib.rs
@@ -277 +277 @@
-extern crate proc_macro;
+pub extern crate proc_macro;
